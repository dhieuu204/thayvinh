MONGO_URI=mongodb://localhost:27017/ecommerce
PORT=3000

# Tạo bằng: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_RANDOM_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_64_BYTE_RANDOM_STRING

CLIENT_URL=http://localhost:5174
SERVER_URL=http://localhost:3000

# VNPay sandbox — đăng ký tại sandbox.vnpayment.vn
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3000/api/payments/vnpay/return

# Gmail App Password — tạo tại myaccount.google.com/apppasswords
MAIL_USER=your_email@gmail.com
MAIL_PASS=

# Google OAuth — tạo tại console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini API — tạo free key tại https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
